import requests
from flask import Flask, request, jsonify, render_template
import threading
import time
import json

app = Flask(__name__)

# ==========================================
# ⚙️ CONFIGURATION 
# ==========================================
# Double check this matches the Arduino Serial Monitor!
MCU_IP = "http://10.11.78.153"  

# Note: No API keys needed here anymore. Your Mac is the brain!

# ==========================================
# 🌉 HARDWARE BRIDGE (TALKS TO NODEMCU)
# ==========================================
def send_to_mcu(endpoint, params=None):
    """Sends HTTP requests to the ESP8266 over Wi-Fi"""
    try:
        requests.get(f"{MCU_IP}{endpoint}", params=params, timeout=2.0)
    except Exception as e:
        print(f"[Warning] Hardware Connection Error: {e}")

# ==========================================
# 🛡️ AUTONOMOUS SAFETY SUBSYSTEM
# ==========================================
def autonomous_safety_check():
    """Monitors ultrasonic sensor. (Fails silently if unplugged)."""
    while True:
        try:
            resp = requests.get(f"{MCU_IP}/api/sensor", timeout=1).json()
            dist = resp.get("distance_cm", 999)
            if 0 < dist < 25.0:
                print(f"⚠️ EMERGENCY HALT: Obstacle at {dist}cm")
                send_to_mcu("/api/base", {"dir": "stop"})
        except:
            pass
        time.sleep(0.5)

threading.Thread(target=autonomous_safety_check, daemon=True).start()

# ==========================================
# 🌐 WEB DASHBOARD & MANUAL CONTROLS
# ==========================================
@app.route('/')
def index():
    return render_template('index.html')

@app.route('/api/base')
def manual_base():
    direction = request.args.get('dir')
    print(f"🛞 Base Command: Moving {direction}")
    send_to_mcu("/api/base", {"dir": direction})
    return jsonify({"status": "forwarded"})

@app.route('/api/arm')
def manual_arm():
    ch = request.args.get('ch')
    ang = request.args.get('ang')
    print(f"🦾 Arm Command: Channel {ch} to {ang}°")
    send_to_mcu("/api/arm", {"ch": ch, "ang": ang})
    return jsonify({"status": "forwarded"})

@app.route('/api/detach')
def detach_arm():
    """Teaching Mode: Kills PWM so human can move joints by hand"""
    print("🔓 Releasing Servo Torque for Teaching Mode...")
    send_to_mcu("/api/detach")
    return jsonify({"status": "relaxed"})

@app.route('/api/estop')
def emergency_stop():
    """Immediately freezes all hardware movement"""
    print("🚨 EMERGENCY HALT INITIATED FROM DASHBOARD!")
    send_to_mcu("/api/estop")
    return jsonify({"status": "halted"})

@app.route('/api/sensor')
def proxy_sensor():
    try:
        resp = requests.get(f"{MCU_IP}/api/sensor", timeout=1).json()
        return jsonify(resp)
    except:
        return jsonify({"distance_cm": "Offline"})

# ==========================================
# 🧠 COGNITIVE AI PIPELINE (LOCAL OLLAMA)
# ==========================================
@app.route('/api/ai_chat')
def ai_chat():
    user_input = request.args.get('text', '')
    print(f"\n[USER COMMAND]: {user_input}")

    # --- THE FIX: FEW-SHOT PROMPTING ---
    # Small models learn by copying examples, not by reading long rules.
    prompt = f"""You are a strict JSON robot controller. Translate the user command into a JSON array.

    TOOLS ALLOWED:
    - Drive: {{"action": "drive", "dir": "forward"|"backward"|"left"|"right"|"stop", "meters": float}}
    - Arm: {{"action": "arm", "ch": 0|1|2|3|4, "ang": 0-180}} (Note: 'base arm joint' = ch 0, 'shoulder' = ch 1)

    EXAMPLES:
    User: "move forward one meter"
    Output: [{{"action": "drive", "dir": "forward", "meters": 1.0}}]

    User: "turn the base arm joint to 50 degree"
    Output: [{{"action": "arm", "ch": 0, "ang": 50}}]

    User: "stop the robot and move the shoulder to 90"
    Output: [{{"action": "drive", "dir": "stop", "meters": 0.0}}, {{"action": "arm", "ch": 1, "ang": 90}}]

    User: "{user_input}"
    Output: """
    # -----------------------------------

    try:
        response = requests.post('http://localhost:11434/api/generate', json={
            "model": "llama3.2",
            "prompt": prompt,
            "stream": False,
            "format": "json" 
        }, timeout=20.0)
        
        raw_text = response.json().get('response', '[]')
        raw_json = json.loads(raw_text)
        print(f"[RAW AI OUTPUT]: {raw_json}")

        # The Deep Search Algorithm
        commands = []
        def extract_commands(data):
            if isinstance(data, dict):
                if 'action' in data and data['action'] in ['drive', 'arm']:
                    commands.append(data)
                else:
                    for value in data.values():
                        extract_commands(value)
            elif isinstance(data, list):
                for item in data:
                    extract_commands(item)
            elif isinstance(data, str):
                # Extra Safety Net: If the AI puts the JSON inside a string
                if '"action"' in data:
                    try:
                        parsed_str = json.loads(data)
                        extract_commands(parsed_str)
                    except: pass
                    
        extract_commands(raw_json)
        print(f"[EXTRACTED COMMANDS]: {commands}")

        def run_commands():
            try:
                for cmd in commands:
                    if cmd.get('action') == 'drive':
                        send_to_mcu("/api/base", {"dir": cmd.get('dir', 'stop')})
                        duration = float(cmd.get('meters', 0.5)) * 2.0
                        time.sleep(duration)
                        send_to_mcu("/api/base", {"dir": "stop"})
                        time.sleep(0.5) 
                    elif cmd.get('action') == 'arm':
                        send_to_mcu("/api/arm", {"ch": cmd.get('ch', 0), "ang": cmd.get('ang', 90)})
                        time.sleep(0.5) 
            except Exception as e:
                print(f"⚠️ [ERROR in Hardware Thread]: {e}")

        threading.Thread(target=run_commands).start()
        return jsonify({"status": "executing", "commands": commands})

    except Exception as e:
        print(f"[ERROR] Local AI Parsing failed: {e}")
        return jsonify({"status": "error", "message": str(e)})
# ==========================================
# 🚀 START SERVER
# ==========================================
if __name__ == '__main__':
    print("Initializing Offline Neural Control Server on Port 5004...")
    app.run(host='0.0.0.0', port=5004, debug=True, use_reloader=False)

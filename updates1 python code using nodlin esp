# ==========================================
# 🌉 HARDWARE BRIDGE (TALKS TO NODEMCU)
# ==========================================
def send_to_mcu(endpoint, params):
    """Sends HTTP GET requests to the ESP8266 over Wi-Fi"""
    try:
        # 2.0s timeout gives the ESP breathing room if Wi-Fi sags
        requests.get(f"{MCU_IP}{endpoint}", params=params, timeout=2.0)
    except Exception as e:
        print(f"[Warning] Hardware Connection Error: {e}")

# ==========================================
# 🛡️ AUTONOMOUS SAFETY SUBSYSTEM
# ==========================================
def autonomous_safety_check():
    """Constantly monitors the ultrasonic sensor (if active)."""
    while True:
        try:
            resp = requests.get(f"{MCU_IP}/api/sensor", timeout=1).json()
            dist = resp.get("distance_cm", 999)
            
            # If an object is closer than 25cm, forcefully stop the motors
            if 0 < dist < 25.0:
                print(f"⚠️ EMERGENCY HALT: Obstacle detected at {dist}cm")
                send_to_mcu("/api/base", {"dir": "stop"})
        except:
            # Fails silently if you haven't wired the ultrasonic sensor yet
            pass
        time.sleep(0.5) # Poll the sensor every 500ms

# Start the safety thread immediately in the background
threading.Thread(target=autonomous_safety_check, daemon=True).start()


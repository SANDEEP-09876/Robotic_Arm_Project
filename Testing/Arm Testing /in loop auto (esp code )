#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

ESP8266WebServer server(80);
Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver();

void setup() {
  Serial.begin(115200);
  
  // Initialize I2C explicitly on D2 (SDA) and D1 (SCL)
  Wire.begin(4, 5); 
  
  // Initialize Servo Driver
  pwm.begin();
  pwm.setOscillatorFrequency(27000000);
  pwm.setPWMFreq(50); // Standard 50Hz for analog servos
  delay(10);

  // Connect Wi-Fi
  Serial.println("\nConnecting to Wi-Fi...");
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  
  Serial.println("\n✅ Connected!");
  Serial.print("NodeMCU IP: ");
  Serial.println(WiFi.localIP());

  // Listen for the Arm API
  server.on("/api/arm", handleArm);
  server.begin();
}

void loop() {
  server.handleClient();
}

void handleArm() {
  // Read the URL parameters (e.g., ?ch=0&ang=90)
  int ch = server.arg("ch").toInt();
  int ang = server.arg("ang").toInt();
  
  // Map 0-180 degrees to PCA9685 pulse lengths (150 to 600)
  int pulse = map(ang, 0, 180, 150, 600);
  pwm.setPWM(ch, 0, pulse);
  
  // Send success back to Python
  server.send(200, "text/plain", "Servo Moved");
  Serial.println("Moved Channel " + String(ch) + " to " + String(ang) + " degrees.");
}

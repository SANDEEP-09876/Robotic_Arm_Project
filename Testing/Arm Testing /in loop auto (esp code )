#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

// Initialize the PCA9685
Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver();

// Servo pulse widths (Standard for 0 to 180 degrees)
const int SERVOMIN = 150; // Minimum pulse length count (0 degrees)
const int SERVOMAX = 600; // Maximum pulse length count (180 degrees)

void setup() {
  Serial.begin(115200);
  Serial.println("Starting 5-DOF Arm Hardware Diagnostic...");

  // Force I2C pins for NodeMCU (SDA = D2/GPIO4, SCL = D1/GPIO5)
  Wire.begin(4, 5); 

  pwm.begin();
  pwm.setOscillatorFrequency(27000000);
  pwm.setPWMFreq(50); // Analog servos run at 50 Hz
  
  delay(10);
  Serial.println("Diagnostic Ready. Beginning Sweep loop...");
}

void loop() {
  Serial.println("Sweeping Forward (0 to 180)...");
  for (uint16_t pulselen = SERVOMIN; pulselen < SERVOMAX; pulselen += 5) {
    // Move all 5 joints (Channels 0, 1, 2, 3, 4) at the same time
    for (int channel = 0; channel < 5; channel++) {
      pwm.setPWM(channel, 0, pulselen);
    }
    delay(20); // Small delay to allow servos to physically move
  }

  delay(500); // Pause at maximum extension

  Serial.println("Sweeping Backward (180 to 0)...");
  for (uint16_t pulselen = SERVOMAX; pulselen > SERVOMIN; pulselen -= 5) {
    // Move all 5 joints back
    for (int channel = 0; channel < 5; channel++) {
      pwm.setPWM(channel, 0, pulselen);
    }
    delay(20);
  }

  delay(500); // Pause at resting position
}

#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

// PCA9685 object
Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver();

// Servo limits
const int SERVOMIN = 150;
const int SERVOMAX = 600;

// Total servos
const int NUM_SERVOS = 5;

// Current servo positions
int currentPos[NUM_SERVOS];

// Target positions
int targetPos[NUM_SERVOS];

// Speed control
const int STEP_SIZE = 1;      // Smaller = smoother
const int STEP_DELAY = 8;     // Lower = faster

//--------------------------------------------------
// Smooth movement function
//--------------------------------------------------
void moveServosSmooth() {

  bool moving = true;

  while (moving) {

    moving = false;

    for (int ch = 0; ch < NUM_SERVOS; ch++) {

      if (currentPos[ch] < targetPos[ch]) {
        currentPos[ch] += STEP_SIZE;

        if (currentPos[ch] > targetPos[ch]) {
          currentPos[ch] = targetPos[ch];
        }

        moving = true;
      }

      else if (currentPos[ch] > targetPos[ch]) {
        currentPos[ch] -= STEP_SIZE;

        if (currentPos[ch] < targetPos[ch]) {
          currentPos[ch] = targetPos[ch];
        }

        moving = true;
      }

      // Update servo
      pwm.setPWM(ch, 0, currentPos[ch]);
    }

    delay(STEP_DELAY);
  }
}

//--------------------------------------------------
// Setup
//--------------------------------------------------
void setup() {

  Serial.begin(115200);

  Serial.println("Smooth 5-DOF Arm Test");

  // ESP8266 I2C pins
  Wire.begin(4, 5);

  pwm.begin();

  pwm.setOscillatorFrequency(27000000);

  pwm.setPWMFreq(50);

  delay(100);

  // Initialize all servos to minimum
  for (int i = 0; i < NUM_SERVOS; i++) {

    currentPos[i] = SERVOMIN;

    pwm.setPWM(i, 0, currentPos[i]);
  }

  delay(1000);
}

//--------------------------------------------------
// Main Loop
//--------------------------------------------------
void loop() {

  //------------------------------------------------
  // Move Forward Smoothly
  //------------------------------------------------
  Serial.println("Moving Forward");

  for (int i = 0; i < NUM_SERVOS; i++) {
    targetPos[i] = SERVOMAX;
  }

  moveServosSmooth();

  delay(1000);

  //------------------------------------------------
  // Move Backward Smoothly
  //------------------------------------------------
  Serial.println("Moving Backward");

  for (int i = 0; i < NUM_SERVOS; i++) {
    targetPos[i] = SERVOMIN;
  }

  moveServosSmooth();

  delay(1000);
}
